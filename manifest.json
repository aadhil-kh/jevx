{
  "manifest_version": 3,
  "name": "jevx",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Live Jev sentiment labels (positive / neutral / negative) for tweets and replies on X conversation pages.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
